+/* Per-Yee-point susceptibility-sigma readers, mirroring the get_chi1inv family
+   above.  `n` is the 0-based index into the chiP[type(c)] chain (head first);
+   enumerate the chain with get_num_susceptibilities and identify entries by
+   get_susceptibility_params (the in-memory twin of dump_params).  Semantics
+   differ from chi1inv in exactly one place: a NULL sigma array means the value
+   is identically zero (trivial_sigma, meep.hpp), not vacuum-1 -- and outside
+   the computational cell the answer is 0.0 for every (c, d), because vacuum
+   carries no susceptibility.  Sigma is a rank-2 tensor row exactly like
+   chi1inv, so the symmetry transform and off-diagonal sign flip carry over
+   unchanged. */
+
+double structure_chunk::get_susceptibility_sigma_at_pt(component c, direction d, int idx,
+                                                       int n) const {
+  if (!is_mine()) return 0.0;
+  susceptibility *sus = chiP[type(c)];
+  for (int i = 0; i < n && sus; ++i)
+    sus = sus->next;
+  if (!sus) meep::abort("susceptibility index %d out of range in get_susceptibility_sigma", n);
+  return sus->sigma[c][d] ? (double)sus->sigma[c][d][idx] : 0.0;
+}
+
+double structure_chunk::get_susceptibility_sigma(component c, direction d, const ivec &iloc,
+                                                 int n) const {
+  return get_susceptibility_sigma_at_pt(c, d, gv.index(c, iloc), n);
+}
+
+int structure::get_num_susceptibilities(field_type ft) const {
+  /* every process builds the full clone chain on every chunk (only the sigma
+     FILL is is_mine()-guarded, the chain itself is not), so chunk 0 answers
+     for all of them */
+  if (num_chunks <= 0) return 0;
+  int count = 0;
+  for (susceptibility *sus = chunks[0]->chiP[ft]; sus; sus = sus->next)
+    ++count;
+  return count;
+}
+
+std::vector<double> structure::get_susceptibility_params(field_type ft, int n) const {
+  if (num_chunks <= 0) meep::abort("no chunks in get_susceptibility_params");
+  susceptibility *sus = chunks[0]->chiP[ft];
+  for (int i = 0; i < n && sus; ++i)
+    sus = sus->next;
+  if (!sus) meep::abort("susceptibility index %d out of range in get_susceptibility_params", n);
+  return sus->get_params_list();
+}
+
+double structure::get_susceptibility_sigma(component c, direction d, const ivec &origloc, int n,
+                                           bool parallel) const {
+  ivec iloc = origloc;
+  for (int sn = 0; sn < S.multiplicity(); sn++)
+    for (int i = 0; i < num_chunks; i++)
+      if (chunks[i]->gv.owns(S.transform(iloc, sn))) {
+        signed_direction ds = S.transform(d, sn);
+        double val = chunks[i]->get_susceptibility_sigma(S.transform(c, sn), ds.d,
+                                                         S.transform(iloc, sn), n) *
+                     (ds.flipped ^ S.transform(component_direction(c), sn).flipped ? -1 : 1);
+        return parallel ? sum_to_all(val) : val;
+      }
+  return 0.0; // outside the computational cell: vacuum carries no susceptibility
+}
+
+double fields_chunk::get_susceptibility_sigma(component c, direction d, const ivec &iloc,
+                                              int n) const {
+  return s->get_susceptibility_sigma(c, d, iloc, n);
+}
+
+double fields::get_susceptibility_sigma(component c, direction d, const ivec &origloc, int n,
+                                        bool parallel) const {
+  ivec iloc = origloc;
+  complex<double> aaack = 1.0;
+  locate_point_in_user_volume(&iloc, &aaack);
+  for (int sn = 0; sn < S.multiplicity(); sn++)
+    for (int i = 0; i < num_chunks; i++)
+      if (chunks[i]->gv.owns(S.transform(iloc, sn))) {
+        signed_direction ds = S.transform(d, sn);
+        double val = chunks[i]->get_susceptibility_sigma(S.transform(c, sn), ds.d,
+                                                         S.transform(iloc, sn), n) *
+                     (ds.flipped ^ S.transform(component_direction(c), sn).flipped ? -1 : 1);
+        return parallel ? sum_to_all(val) : val;
+      }
+  return 0.0; // outside the computational cell: vacuum carries no susceptibility
+}
+
+int fields::get_num_susceptibilities(field_type ft) const {
+  if (num_chunks <= 0) return 0;
+  int count = 0;
+  for (susceptibility *sus = chunks[0]->s->chiP[ft]; sus; sus = sus->next)
+    ++count;
+  return count;
+}
+
+std::vector<double> fields::get_susceptibility_params(field_type ft, int n) const {
+  if (num_chunks <= 0) meep::abort("no chunks in get_susceptibility_params");
+  susceptibility *sus = chunks[0]->s->chiP[ft];
+  for (int i = 0; i < n && sus; ++i)
+    sus = sus->next;
+  if (!sus) meep::abort("susceptibility index %d out of range in get_susceptibility_params", n);
+  return sus->get_params_list();
+}
